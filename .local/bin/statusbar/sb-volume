#!/usr/bin/env sh
# TODO: reduce all wpctl commands into one

sink="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
src="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)"

sink_muted=0
src_muted=0

[ "$sink" != "${sink%\[MUTED\]}" ] && {
	sink_icon=""
	sink_muted=1
}

[ "$src" != "${src%\[MUTED\]}" ] && {
	src_icon=" "
	src_muted=1
} || src_icon=""

get_bluetooth=$(wpctl inspect @DEFAULT_AUDIO_SINK@)
case $get_bluetooth in
	*'node.name = "bluez_output'*)
		bt_icon=" "
		;;
esac

sink="${sink#Volume: }"
src="${src#Volume: }"

split() {
	# For ommiting the . without calling an external program.
	IFS=$2
	set -- $1 # this should not be double quated
	printf '%s' "$@"
}

sink="$(printf "%.0f" "$(split "$sink" ".")")"
src="$(printf "%.0f" "$(split "$src" ".")")"

if [ "$sink_muted" -ne 1 ]; then
	case 1 in
		$((sink >= 70)) ) sink_icon=" " ;;
		$((sink >= 30)) ) sink_icon="" ;;
		$((sink >= 1)) ) sink_icon="" ;;
		* ) sink_icon="" ;;
	esac
fi

[ "$sink_muted" -eq 1 ] && sink="(${sink}%)" || sink="${sink}%"
[ "$src_muted" -eq 1 ] && src="(${src}%)" || src="${src}%"

printf '%s%s %s  %s %s' \
	"$bt_icon" \
	"$sink_icon" \
	"$sink" \
	"$src_icon" \
	"$src"
